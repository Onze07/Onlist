rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function familyPath(fid) {
      return /databases/$(database)/documents/families/$(fid);
    }

    function isMember(fid) {
      return signedIn() && request.auth.uid in get(familyPath(fid)).data.members;
    }

    // Dono (createdBy) ou admin
    function isAdminOf(data) {
      return request.auth.uid == data.createdBy || request.auth.uid in data.get('admins', []);
    }

    // Vagas do plano. `plan` só é gravado pelo servidor (Admin SDK).
    // Sem plano = sem cobrança ainda: 20 vagas, só contra abuso de código vazado.
    function seatsOf(data) {
      return data.get('plan', {}).get('seats', 20);
    }

    function unchanged(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    // Perfil do usuário: só o próprio dono
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Código de convite -> familyId. Leitura só por ID exato (sem listagem).
    match /familyCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && getAfter(familyPath(request.resource.data.familyId)).data.code == code
        && request.auth.uid in getAfter(familyPath(request.resource.data.familyId)).data.members;
      // Apagar código antigo ao gerar um novo (só admin, e só se a família já usa outro código)
      // ou junto com a exclusão da família
      allow delete: if signedIn()
        && isAdminOf(get(familyPath(resource.data.familyId)).data)
        && (!existsAfter(familyPath(resource.data.familyId))
            || getAfter(familyPath(resource.data.familyId)).data.code != code);
      allow update: if false;
    }

    // Feedback: qualquer usuário envia; leitura só pelo console do Firebase
    match /feedback/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if false;
    }

    match /families/{fid} {
      allow get: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.get('admins', []) == []
        && !('plan' in request.resource.data);

      // Admin: renomear, remover membros, trocar código. Só o dono mexe em admins
      // e só o dono passa a posse (createdBy) para outro membro.
      allow update: if signedIn()
        && isAdminOf(resource.data)
        && unchanged(['plan'])
        && (unchanged(['createdBy']) || (
              request.auth.uid == resource.data.createdBy
              && request.resource.data.createdBy in resource.data.members
              && request.resource.data.createdBy in request.resource.data.members
            ))
        // só remove, nunca adiciona membros por aqui
        && resource.data.members.toSet().hasAll(request.resource.data.members)
        // dono nunca é removido
        && resource.data.createdBy in request.resource.data.members
        // admins precisam ser membros
        && request.resource.data.members.toSet().hasAll(request.resource.data.get('admins', []))
        && (request.auth.uid == resource.data.createdBy || (
              unchanged(['admins'])
              // admin comum não remove outro admin
              && request.resource.data.members.toSet().hasAll(resource.data.get('admins', []))
            ))
        && (unchanged(['code'])
            || getAfter(/databases/$(database)/documents/familyCodes/$(request.resource.data.code)).data.familyId == fid);

      // Sair da família (qualquer membro, exceto o dono)
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.auth.uid != resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'admins'])
        && request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet())
        && request.resource.data.get('admins', []).toSet() == resource.data.get('admins', []).toSet().difference([request.auth.uid].toSet());

      // Entrar: só adiciona a si mesmo, prova que conhece o código
      // (users/{uid}.joinCode no mesmo batch) e respeita o limite de vagas
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.toSet() == resource.data.members.toSet().union([request.auth.uid].toSet())
        && resource.data.members.size() < seatsOf(resource.data)
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.joinCode == resource.data.code;

      // Excluir a família: só o dono, e só quando ele é o único membro (exclusão de conta)
      allow delete: if signedIn()
        && resource.data.createdBy == request.auth.uid
        && resource.data.members.size() == 1;

      // Nome/foto de cada membro, visível para a família
      match /profiles/{uid} {
        allow read: if isMember(fid);
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && uid in getAfter(familyPath(fid)).data.members;
        allow delete: if signedIn()
          && (request.auth.uid == uid || isAdminOf(get(familyPath(fid)).data));
      }

      // "Fulano está no mercado": cada um grava só a própria presença
      match /presence/{uid} {
        allow read: if isMember(fid);
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && uid in get(familyPath(fid)).data.members;
        allow delete: if signedIn()
          && (request.auth.uid == uid || isAdminOf(get(familyPath(fid)).data));
      }

      // Listas, itens, catálogo, histórico, mercados.
      // {sub} exige ao menos um segmento: não casa com o próprio doc da família
      match /{sub}/{rest=**} {
        allow read, write: if !(sub in ['profiles', 'presence']) && isMember(fid);
      }
    }
  }
}
